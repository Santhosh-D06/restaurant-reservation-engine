# Copy this file to .env and fill in values. Never commit .env.
PORT=5000
NODE_ENV=development

# Local MongoDB (Windows service, default port):
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_reservation
# Or MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/restaurant_reservation

# Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Used only by `npm run seed` to create the admin account. Set your own values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
